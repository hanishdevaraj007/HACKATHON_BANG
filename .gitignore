models/
*.pt
*.onnx
*.weights

# SQLite databases (generated at runtime)
*.db
*.sqlite
*.sqlite3

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Logs
logs/
*.log

# Node (frontend)
node_modules/
