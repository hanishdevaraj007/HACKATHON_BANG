{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meridian-security/schema/incident.schema.json",
  "title": "Security Incident",
  "description": "Incident generated by the correlation engine. See docs/INCIDENT_CONTRACT.md.",
  "type": "object",
  "required": [
    "incident_id",
    "created_at",
    "updated_at",
    "status",
    "severity",
    "score",
    "score_breakdown",
    "title",
    "signals",
    "events",
    "entities"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "description": "Unique incident identifier. Format: INC-{UUID-short}.",
      "pattern": "^INC-[0-9a-f]{8}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the incident was first created."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the most recent update."
    },
    "status": {
      "type": "string",
      "enum": ["open", "investigating", "escalated", "resolved", "false_positive"],
      "description": "Current lifecycle status."
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "description": "Derived from score. See scoring contract."
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Deterministic risk score. NOT a probability."
    },
    "score_breakdown": {
      "type": "array",
      "description": "Named breakdown of every point contributing to the score.",
      "items": {
        "type": "object",
        "required": ["rule_name", "points", "description"],
        "properties": {
          "rule_name": {
            "type": "string",
            "description": "Canonical scoring rule identifier."
          },
          "points": {
            "type": "integer",
            "description": "Points contributed by this rule."
          },
          "description": {
            "type": "string",
            "description": "Human-readable explanation of why this rule fired."
          },
          "evidence_event_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Event IDs that triggered this rule."
          }
        }
      }
    },
    "title": {
      "type": "string",
      "description": "Short human-readable incident title."
    },
    "description": {
      "type": ["string", "null"],
      "description": "Detailed description. May be LLM-generated narrative over structured data."
    },
    "signals": {
      "type": "array",
      "description": "Policy signals that contributed to this incident.",
      "items": {
        "type": "object",
        "required": ["signal_id", "signal_type", "timestamp", "source_event_id"],
        "properties": {
          "signal_id": {
            "type": "string"
          },
          "signal_type": {
            "type": "string",
            "enum": [
              "unauthorized_zone_access",
              "after_hours_activity",
              "sensitive_asset_interaction",
              "usb_activity",
              "large_outbound_transfer",
              "tailgating_suspected",
              "credential_anomaly",
              "object_left_behind",
              "multi_signal_correlation"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "source_event_id": {
            "type": "string"
          },
          "details": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Ordered list of event IDs composing the incident evidence.",
      "items": { "type": "string" }
    },
    "entities": {
      "type": "object",
      "description": "Resolved entities involved in this incident.",
      "properties": {
        "persons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "badges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "accounts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "devices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "zones": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence_graph": {
      "type": ["object", "null"],
      "description": "Lightweight in-memory evidence graph. No graph database.",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "relationship"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "relationship": { "type": "string" },
              "timestamp": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "timeline": {
      "type": ["array", "null"],
      "description": "Chronological evidence timeline for display.",
      "items": {
        "type": "object",
        "required": ["timestamp", "description", "event_id"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "description": { "type": "string" },
          "event_id": { "type": "string" },
          "zone_id": { "type": ["string", "null"] }
        }
      }
    },
    "llm_narrative": {
      "type": ["string", "null"],
      "description": "Optional LLM-generated natural language summary. NEVER load-bearing. Always derived from structured incident data."
    }
  },
  "additionalProperties": false
}
